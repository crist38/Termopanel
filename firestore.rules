rules_version = '2';

// Reglas de Firestore para el cotizador de Termopaneles (Prowindows).
// La app no usa Firebase Auth (la sesión es de Odoo), por eso se lee y escribe
// sin autenticación de Firebase. No se permite borrar nada.
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuración de precios: lib/configService.ts
    match /configuracion/termopaneles {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(
        ['vidrios', 'separadores', 'coloresSeparador', 'preciosSeparadores', 'parametrosCalculo']
      );
    }

    // Cotizaciones guardadas en Firebase mientras Odoo está suspendido:
    // lib/cotizacionesFirestore.ts
    function cotizacionValida() {
      let d = request.resource.data;
      return d.clientName is string && d.clientName.size() > 0
        && d.items is list
        && d.totalNeto is number
        && d.budgetNumber is int
        && d.budgetName is string;
    }

    match /{coleccion}/{id} {
      allow read: if coleccion in ['presupuestos_termopaneles', 'presupuestos_monoliticos', 'presupuestos_formas'];
      allow create: if coleccion in ['presupuestos_termopaneles', 'presupuestos_monoliticos', 'presupuestos_formas']
        && cotizacionValida();
      // Al editar no se puede cambiar el número
      allow update: if coleccion in ['presupuestos_termopaneles', 'presupuestos_monoliticos', 'presupuestos_formas']
        && cotizacionValida()
        && request.resource.data.budgetNumber == resource.data.budgetNumber;
    }

    // Abonos de cotizaciones que viven en Odoo (Odoo no tiene dónde guardarlos):
    // lib/cotizacionesFirestore.ts → guardarAbonosOdoo / leerAbonosOdoo
    match /abonos_odoo/{orderId} {
      allow read: if true;
      allow create, update: if orderId.matches('^[0-9]+$')
        && request.resource.data.keys().hasOnly(['abonos', 'orderName', 'updatedAt'])
        && request.resource.data.abonos is list;
    }

    // Correlativos: solo pueden avanzar de a uno
    match /contadores/{coleccion} {
      allow read: if true;
      allow create: if coleccion in ['presupuestos_termopaneles', 'presupuestos_monoliticos', 'presupuestos_formas']
        && request.resource.data.ultimo == 1;
      allow update: if request.resource.data.ultimo == resource.data.ultimo + 1;
    }
  }
}
